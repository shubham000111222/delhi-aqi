# Copy to .env (git-ignored). Never commit real keys.
# The bot reads .env only at startup and never logs values.

# --- mode switch #2 (mode: live in config is switch #1) ---
LIVE_TRADING_ENABLED=false

# --- exchange keys (trade-only, withdrawals MUST be disabled, IP whitelist on) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_ID=binance

# separate keys for testnet (never reuse live keys)
TESTNET_API_KEY=
TESTNET_API_SECRET=

# --- notifications (optional; template report is written to disk regardless) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A second, independent alert transport. Any endpoint that accepts {"text": "..."} works:
# a Slack incoming webhook, Discord, ntfy, Gotify. Without it, Telegram is a single point
# of failure for the alarm system and `tradebot health` reports alerting DEGRADED.
ALERT_WEBHOOK_URL=

# --- LLM journal (optional; one call per day + one per incident) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=2.00

# --- dashboard ---
# Controls are disabled by default. To enable, set DASHBOARD_READONLY=false and
# a strong password. This token only protects control requests, not dashboard data;
# restrict access to the dashboard separately (e.g. an authenticated reverse proxy).
DASHBOARD_READONLY=true
DASHBOARD_PASSWORD=
